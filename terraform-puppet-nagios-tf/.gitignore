# Local .terraform directories
**/.terraform/*

# Track provider dependency lockfile
!.terraform.lock.hcl

# .tfstate and plan files
*.tfstate
*.tfstate.*
*.tfplan
tfplan

# Crash log files
crash.log
crash.*.log

# Exclude sensitive tfvars files that may contain personal IP addresses
*.tfvars
*.tfvars.json

# Allow example files
!terraform.tfvars.example

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration
.terraformrc
terraform.rc

# SSH keys and certificates
*.pem
*.key
*.pub
