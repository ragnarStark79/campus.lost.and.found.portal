# ════════════════════════════════════════════════════════════════
#  .gitignore — Campus Lost and Found Portal
# ════════════════════════════════════════════════════════════════

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
.eggs/
*.spec

# ── Virtual environments ───────────────────────────────────────
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# ── Environment / secrets ─────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key
*_rsa
*_dsa
*_ecdsa
*_ed25519
id_rsa
id_dsa

# ── Database ──────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
data/

# ── Terraform ─────────────────────────────────────────────────
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform/
.terraform.lock.hcl
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ── Docker ────────────────────────────────────────────────────
docker/volumes/

# ── Testing / coverage ────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
nosetests.xml
coverage.xml
*.cover

# ── Type checking ─────────────────────────────────────────────
.mypy_cache/

# ── IDE / editors ─────────────────────────────────────────────
.vscode/
.idea/
*.iml
*.iws
*.ipr
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Logs ──────────────────────────────────────────────────────
*.log
logs/

# ── OS ────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
desktop.ini

